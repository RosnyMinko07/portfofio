# Copie ce fichier en .env.local et remplis les valeurs (ne jamais commiter .env.local)

# ---------- Site (variables à mettre sur Vercel) ----------

# Chatbot du portfolio (OpenRouter) — clé sur https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Formulaire de contact (Resend) — clé sur https://resend.com
RESEND_API_KEY=
NOTIFICATION_EMAIL=

# (Optionnel) Origines externes autorisées à appeler /api/chatbot, séparées par des virgules
ALLOWED_ORIGINS=

# ---------- Veille emploi Gabon (secrets GitHub Actions + .env.local pour les tests) ----------

# Telegram : bot créé avec @BotFather, puis `npm run telegram:chat-id`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email : réutilise RESEND_API_KEY et NOTIFICATION_EMAIL ci-dessus
# (Optionnel) Expéditeur vérifié sur Resend, ex : Veille Emploi <alertes@ton-domaine.com>
RESEND_FROM=

# Analyse IA des offres : réutilise OPENROUTER_API_KEY ci-dessus (sans clé : tri par mots-clés)
# (Optionnel) Modèle, défaut deepseek/deepseek-chat
OPENROUTER_MODEL=
# (Optionnel) Niveau minimum envoyé sur Telegram : faible (tout, défaut) | moyenne | forte
TELEGRAM_NIVEAU_MIN=
